# =============================================================================
# THE GROWTH ENGINE - Variables de Entorno
# Copiar a .env y completar los valores
# NUNCA commitear .env con valores reales
# =============================================================================

# --- Base de Datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_engine
REDIS_URL=redis://localhost:6379

# --- Autenticación JWT (RS256) ---
# Generar con: openssl genrsa -out certs/private.pem 2048
#              openssl rsa -in certs/private.pem -pubout -out certs/public.pem
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_TTL=900       # 15 minutos en segundos
JWT_REFRESH_TTL=604800   # 7 días en segundos

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- AI Engine (FastAPI) ---
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=internal-secret-key

# --- Meta Ads / WhatsApp ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
META_VERIFY_TOKEN=random-string-for-webhook-verification

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@thegrowthengine.com
SENDGRID_FROM_NAME=The Growth Engine

# --- GCP (solo producción) ---
GCP_PROJECT_ID=growth-engine-prod
GCP_REGION=us-central1

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
FRONTEND_PORT=3000
AI_ENGINE_PORT=8000
