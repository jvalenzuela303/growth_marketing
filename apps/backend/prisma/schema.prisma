// The Growth Engine — Prisma Schema v1.3.0
// Multi-tenant SaaS: Row-Level Security enforced via PrismaService.withTenant()
// snake_case table names via @@map, camelCase field names in application layer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANTS ────────────────────────────────────────────────────────────────

model Tenant {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(100)
  name String @db.VarChar(255)
  plan String @default("starter") @db.VarChar(50) // starter/growth/scale/agency

  // Límites del plan
  maxFunnels          Int @default(1)   @map("max_funnels")
  maxLeadsPerMonth    Int @default(500) @map("max_leads_per_month")
  maxWhatsappMessages Int @default(500) @map("max_whatsapp_messages")

  // Integraciones Meta
  metaPixelId         String? @map("meta_pixel_id")           @db.VarChar(50)
  metaCapiToken       String? @map("meta_capi_token")
  metaWhatsappPhoneId String? @map("meta_whatsapp_phone_id")  @db.VarChar(50)
  metaWhatsappToken   String? @map("meta_whatsapp_token")

  // Integraciones Email
  sendgridApiKey String? @map("sendgrid_api_key")

  // CRM
  ghlApiKey     String? @map("ghl_api_key")
  ghlLocationId String? @map("ghl_location_id") @db.VarChar(100)
  hubspotApiKey String? @map("hubspot_api_key")

  // Configuración regional
  timezone String @default("America/Santiago") @db.VarChar(50)
  currency String @default("CLP")              @db.VarChar(3)

  // Estado
  isActive    Boolean   @default(true)  @map("is_active")
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz()

  // ── Iteration 1: Notificaciones ──────────────────────────────────────────
  alertEmail           String?  @map("alert_email")             @db.VarChar(255)
  hotLeadAlertEnabled  Boolean  @default(true)  @map("hot_lead_alert_enabled")
  dailyDigestEnabled   Boolean  @default(false) @map("daily_digest_enabled")

  // ── Iteration 3: Ads + Scheduling integrations ───────────────────────────
  adAccountId                String? @map("ad_account_id")                  @db.VarChar(100)
  metaInstagramPageId        String? @map("meta_instagram_page_id")         @db.VarChar(100)
  metaInstagramAccessToken   String? @map("meta_instagram_access_token")
  googleCalendarRefreshToken String? @map("google_calendar_refresh_token")
  calendlyApiKey             String? @map("calendly_api_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  // Relaciones
  users           User[]
  funnels         Funnel[]
  leads           Lead[]
  emailSequences  EmailSequence[]
  adSpends        AdSpend[]
  adsAccounts     AdsAccount[]
  adCampaigns     AdCampaign[]
  audienceExports AudienceExport[]
  appointments    Appointment[]
  deals           Deal[]
  subscription      Subscription?
  invoices          Invoice[]
  automationFlows   AutomationFlow[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  // E-commerce integrations (Migration 017)
  shopifyShopDomain    String? @map("shopify_shop_domain")    @db.VarChar(255)
  shopifyAccessToken   String? @map("shopify_access_token")
  shopifyWebhookSecret String? @map("shopify_webhook_secret")
  woocommerceUrl       String? @map("woocommerce_url")        @db.VarChar(500)
  woocommerceKey       String? @map("woocommerce_key")        @db.VarChar(255)
  woocommerceSecret    String? @map("woocommerce_secret")
  abandonedCartMinutes Int     @default(30) @map("abandoned_cart_minutes")

  products          Product[]
  carts             Cart[]

  @@map("tenants")
}

// ─── USERS ──────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  email        String  @unique @db.VarChar(255)
  name         String? @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  role         String  @default("member") @db.VarChar(50) // owner/admin/member/viewer
  avatarUrl    String? @map("avatar_url")
  isActive     Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt   DateTime  @default(now())       @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt            @map("updated_at") @db.Timestamptz()

  // Relaciones
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  funnels       Funnel[]
  assignedLeads Lead[]
  dealsCreated  Deal[]         @relation("DealCreatedBy")

  @@index([tenantId], name: "idx_users_tenant")
  @@index([email], name: "idx_users_email")
  @@map("users")
}

// ─── REFRESH TOKENS ─────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255) // SHA-256 del token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

// ─── FUNNELS ────────────────────────────────────────────────────────────────

model Funnel {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  createdBy   String? @map("created_by") @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @db.VarChar(100)
  description String?

  // Configuraciones JSONB
  quizConfig    Json @default("{\"title\":\"Diagnóstico de Eficiencia\",\"description\":\"\",\"questions\":[],\"lead_gate_position\":5,\"completion_redirect\":null}") @map("quiz_config")
  landingConfig Json @default("{\"headline\":\"\",\"subheadline\":\"\",\"cta_text\":\"Hacer el diagnóstico gratis\",\"theme\":\"default\",\"logo_url\":null,\"custom_css\":null}") @map("landing_config")
  resultsConfig Json @default("{\"segments\":{\"fuego\":{\"headline\":\"\",\"cta\":\"\",\"urgency\":\"\"},\"caliente\":{\"headline\":\"\",\"cta\":\"\",\"urgency\":\"\"},\"tibio\":{\"headline\":\"\",\"cta\":\"\",\"urgency\":\"\"},\"frio\":{\"headline\":\"\",\"cta\":\"\",\"urgency\":\"\"},\"motor_detenido\":{\"headline\":\"\",\"cta\":\"\",\"urgency\":\"\"}}}") @map("results_config")
  scoringRules  Json? @map("scoring_rules")

  // Estado
  status      String    @default("draft") @db.VarChar(20) // draft/active/paused/archived
  publishedAt DateTime? @map("published_at") @db.Timestamptz()

  // Métricas (cache)
  totalViews       Int @default(0) @map("total_views")
  totalStarts      Int @default(0) @map("total_starts")
  totalCompletions Int @default(0) @map("total_completions")

  // ── Iteration 3: A/B testing ──────────────────────────────────────────────
  abTestEnabled Boolean @default(false) @map("ab_test_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  // Relaciones
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation(fields: [createdBy], references: [id])
  leads         Lead[]
  events        LeadEvent[]
  adSpends      AdSpend[]
  variants      FunnelVariant[]
  deals         Deal[]

  @@unique([tenantId, slug])
  @@index([tenantId], name: "idx_funnels_tenant")
  @@index([tenantId, status], name: "idx_funnels_status")
  @@map("funnels")
}

// ─── LEADS ──────────────────────────────────────────────────────────────────

model Lead {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  funnelId String? @map("funnel_id") @db.Uuid

  // Datos personales
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(20)
  firstName String? @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name")  @db.VarChar(100)
  company   String? @db.VarChar(255)

  // Scoring individual (sin generated column — Prisma no soporta GENERATED ALWAYS AS)
  quizScore        Int @default(0) @map("quiz_score")
  behaviorScore    Int @default(0) @map("behavior_score")
  engagementScore  Int @default(0) @map("engagement_score")
  demographicScore Int @default(0) @map("demographic_score")
  // total_score se calcula en DB como columna generada; la leemos como campo virtual
  // Para queries, usar total_score directo con $queryRaw cuando necesites order by
  scoreUpdatedAt DateTime @default(now()) @map("score_updated_at") @db.Timestamptz()

  // Clasificación IA
  segment               String   @default("sin_clasificar") @db.VarChar(20)
  pathology             String?  @db.VarChar(100)
  pathologyConfidence   Decimal? @map("pathology_confidence") @db.Decimal(4, 3)
  classifiedAt          DateTime? @map("classified_at")       @db.Timestamptz()
  classifiedModel       String?   @map("classified_model")    @db.VarChar(50)

  // Scoring predictivo ML
  conversionProbability Decimal? @map("conversion_probability") @db.Decimal(5, 4)
  conversionLabel       String?  @map("conversion_label")       @db.VarChar(10)  // alto | medio | bajo
  predictionUpdatedAt   DateTime? @map("prediction_updated_at") @db.Timestamptz()

  // Origen UTM
  source      String  @default("direct") @db.VarChar(50)
  utmSource   String? @map("utm_source")   @db.VarChar(100)
  utmMedium   String? @map("utm_medium")   @db.VarChar(100)
  utmCampaign String? @map("utm_campaign") @db.VarChar(255)
  utmContent  String? @map("utm_content")  @db.VarChar(255)
  metaFbclid  String? @map("meta_fbclid")  @db.VarChar(255)
  metaFbp     String? @map("meta_fbp")     @db.VarChar(255)
  metaFbc     String? @map("meta_fbc")     @db.VarChar(255)
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  // Estado CRM
  pipelineStage          String    @default("nuevo")   @map("pipeline_stage") @db.VarChar(50)
  pipelineStageUpdatedAt DateTime  @default(now())     @map("pipeline_stage_updated_at") @db.Timestamptz()
  assignedTo             String?   @map("assigned_to") @db.Uuid

  // Respuestas y comportamiento
  quizAnswers              Json      @default("{}") @map("quiz_answers")
  quizCompletedAt          DateTime? @map("quiz_completed_at") @db.Timestamptz()
  quizCompletionPercentage Int       @default(0)   @map("quiz_completion_percentage")
  behaviorData             Json      @default("{\"visits\":0,\"pricing_page_clicks\":0,\"total_time_seconds\":0,\"email_opens\":0,\"email_clicks\":0,\"whatsapp_replies\":0}") @map("behavior_data")

  // Notas y tags
  notes    String?
  tags     String[] @default([])
  aiMemory String?  @map("ai_memory") // Running AI-generated context summary

  // Alertas
  hotLeadAlertSentAt DateTime? @map("hot_lead_alert_sent_at") @db.Timestamptz()

  // ── Iteration 3: A/B variant assignment ───────────────────────────────────
  variantId String? @map("variant_id") @db.Uuid

  // Timestamps
  createdAt  DateTime  @default(now()) @map("created_at")   @db.Timestamptz()
  updatedAt  DateTime  @updatedAt      @map("updated_at")   @db.Timestamptz()
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  deletedAt  DateTime? @map("deleted_at")                   @db.Timestamptz()

  // Relaciones
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funnel                   Funnel?                   @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  assignedUser             User?                     @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  variant                  FunnelVariant?            @relation(fields: [variantId], references: [id], onDelete: SetNull)
  conversations            Conversation[]
  events                   LeadEvent[]
  chatSessions             ChatSession[]
  emailSequenceEnrollments EmailSequenceEnrollment[]
  appointments             Appointment[]
  deals                    Deal[]
  carts                    Cart[]

  @@index([tenantId, segment], name: "idx_leads_tenant_segment")
  @@index([tenantId, pipelineStage], name: "idx_leads_tenant_stage")
  @@index([tenantId, createdAt(sort: Desc)], name: "idx_leads_tenant_created")
  @@index([funnelId], name: "idx_leads_funnel")
  @@index([tenantId, email], name: "idx_leads_email")
  @@map("leads")
}

// ─── CONVERSATIONS ───────────────────────────────────────────────────────────

model Conversation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id")   @db.Uuid

  // Canal y dirección
  channel     String @db.VarChar(20) // whatsapp/email/chat/sms
  role        String @db.VarChar(15) // user/assistant/human_agent/system

  // Contenido
  content     String
  contentType String @default("text") @map("content_type") @db.VarChar(20)

  // Metadatos del mensaje
  metadata Json @default("{}")

  // Estado de envío
  status            String  @default("sent")    @db.VarChar(20)
  externalMessageId String? @map("external_message_id") @db.VarChar(255)

  // IA info
  aiModel      String? @map("ai_model")       @db.VarChar(50)
  aiTokensUsed Int?    @map("ai_tokens_used")
  aiLatencyMs  Int?    @map("ai_latency_ms")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at")                  @db.Timestamptz()

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)], name: "idx_conv_lead")
  @@index([tenantId, createdAt(sort: Desc)], name: "idx_conv_tenant")
  @@index([tenantId, channel, createdAt(sort: Desc)], name: "idx_conv_channel")
  @@map("conversations")
}

// ─── LEAD EVENTS ─────────────────────────────────────────────────────────────

model LeadEvent {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  leadId   String? @map("lead_id")   @db.Uuid
  funnelId String? @map("funnel_id") @db.Uuid

  // Tipo de evento
  eventType String @map("event_type") @db.VarChar(50)
  eventData Json   @default("{}") @map("event_data")

  // Atribución
  sessionId String? @map("session_id") @db.VarChar(100)
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventType, createdAt(sort: Desc)], name: "idx_events_tenant_type")
  @@index([leadId, createdAt(sort: Desc)], name: "idx_events_lead")
  @@index([funnelId, eventType, createdAt(sort: Desc)], name: "idx_events_funnel")
  @@map("lead_events")
}

// ─── ITERATION 2: CHAT SESSIONS ──────────────────────────────────────────────

model ChatSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  channel        String   @db.VarChar(20)
  status         String   @default("active") @db.VarChar(20)
  context        Json     @default("{}")
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], name: "idx_chat_sessions_lead")
  @@index([tenantId, status], name: "idx_chat_sessions_tenant_status")
  @@map("chat_sessions")
}

// ─── ITERATION 2: EMAIL SEQUENCES ────────────────────────────────────────────

model EmailSequence {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  funnelId        String?  @map("funnel_id") @db.Uuid
  name            String   @db.VarChar(255)
  trigger         String   @db.VarChar(50)
  triggerSegments String[] @map("trigger_segments")
  minScore        Int?     @map("min_score")
  maxScore        Int?     @map("max_score")
  isActive        Boolean  @default(true) @map("is_active")
  steps           Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments EmailSequenceEnrollment[]

  @@index([tenantId, isActive], name: "idx_email_seq_tenant")
  @@map("email_sequences")
}

// ─── ITERATION 2: EMAIL SEQUENCE ENROLLMENTS ─────────────────────────────────

model EmailSequenceEnrollment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceId  String    @map("sequence_id") @db.Uuid
  leadId      String    @map("lead_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  currentStep Int       @default(0) @map("current_step")
  status      String    @default("active") @db.VarChar(20)
  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz()
  nextSendAt  DateTime? @map("next_send_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, leadId])
  @@index([tenantId, nextSendAt], name: "idx_enrollment_next_send")
  @@map("email_sequence_enrollments")
}

// ─── ITERATION 2: AD SPEND ───────────────────────────────────────────────────

model AdSpend {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  funnelId     String?  @map("funnel_id") @db.Uuid
  source       String   @db.VarChar(50)
  campaignId   String?  @map("campaign_id") @db.VarChar(255)
  campaignName String?  @map("campaign_name") @db.VarChar(255)
  spendAmount  Decimal  @map("spend_amount") @db.Decimal(14, 2)
  currency     String   @default("CLP") @db.VarChar(3)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)

  @@index([tenantId, periodStart], name: "idx_ad_spend_tenant_period")
  @@map("ad_spend")
}

// ─── ITERATION 3: FUNNEL VARIANTS (A/B TESTING) ──────────────────────────────

model FunnelVariant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  funnelId         String   @map("funnel_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String   @db.VarChar(100)
  trafficSplit     Int      @map("traffic_split")
  quizConfig       Json?    @map("quiz_config")
  landingConfig    Json?    @map("landing_config")
  resultsConfig    Json?    @map("results_config")
  isControl        Boolean  @default(false) @map("is_control")
  isActive         Boolean  @default(true)  @map("is_active")
  totalViews       Int      @default(0) @map("total_views")
  totalStarts      Int      @default(0) @map("total_starts")
  totalCompletions Int      @default(0) @map("total_completions")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@index([funnelId, isActive], name: "idx_variants_funnel")
  @@map("funnel_variants")
}

// ─── ITERATION 3: APPOINTMENTS ───────────────────────────────────────────────

model Appointment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  leadId          String    @map("lead_id") @db.Uuid
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz()
  durationMins    Int       @default(30) @map("duration_mins")
  status          String    @default("scheduled") @db.VarChar(20)
  channel         String    @default("video_call") @db.VarChar(30)
  meetingUrl      String?   @map("meeting_url")
  notes           String?
  calendarEventId String?   @map("calendar_event_id") @db.VarChar(255)
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt], name: "idx_appointments_tenant")
  @@index([leadId], name: "idx_appointments_lead")
  @@map("appointments")
}

// ─── ITERATION 4: ADS ACCOUNTS (multi-account management) ────────────────────

model AdsAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(255)
  platform          String    @default("meta") @db.VarChar(20) // meta | google | tiktok | linkedin
  externalAccountId String    @map("external_account_id") @db.VarChar(255)
  accessToken       String?   @map("access_token")
  status            String    @default("active") @db.VarChar(20) // active | paused | disconnected | error
  isDefault         Boolean   @default(false) @map("is_default")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz()
  syncErrorMessage  String?   @map("sync_error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns AdCampaign[]
  deals     Deal[]

  @@unique([tenantId, platform, externalAccountId], name: "uq_ads_accounts_tenant_platform_external")
  @@index([tenantId, status], name: "idx_ads_accounts_tenant")
  @@map("ads_accounts")
}

// ─── ITERATION 3: AD CAMPAIGNS ───────────────────────────────────────────────

model AdCampaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  adsAccountId   String?   @map("ads_account_id") @db.Uuid
  externalId     String    @map("external_id") @db.VarChar(255)
  name           String    @db.VarChar(255)
  status         String    @db.VarChar(20)
  objective      String?   @db.VarChar(100)
  budgetDaily    Decimal?  @map("budget_daily") @db.Decimal(14, 2)
  budgetTotal    Decimal?  @map("budget_total") @db.Decimal(14, 2)
  platform       String    @default("meta") @db.VarChar(20)
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsAccount AdsAccount? @relation(fields: [adsAccountId], references: [id], onDelete: SetNull)
  metrics    AdCampaignMetric[]

  @@unique([tenantId, externalId])
  @@index([tenantId, status], name: "idx_campaigns_tenant_status")
  @@index([adsAccountId], name: "idx_campaigns_ads_account")
  @@map("ad_campaigns")
}

// ─── ITERATION 3: AD CAMPAIGN METRICS ────────────────────────────────────────

model AdCampaignMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @db.Decimal(14, 2)
  leads       Int      @default(0)
  reach       Int      @default(0)
  frequency   Decimal  @default(0) @db.Decimal(6, 2)
  cpm         Decimal  @default(0) @db.Decimal(10, 4)
  cpc         Decimal  @default(0) @db.Decimal(10, 4)
  ctr         Decimal  @default(0) @db.Decimal(6, 4)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([tenantId], name: "idx_campaign_metrics_tenant")
  @@map("ad_campaign_metrics")
}

// ─── ITERATION 3: AUDIENCE EXPORTS ───────────────────────────────────────────

model AudienceExport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  type           String   @db.VarChar(30)
  segment        String   @db.VarChar(20)
  metaAudienceId String?  @map("meta_audience_id") @db.VarChar(100)
  leadCount      Int      @map("lead_count")
  status         String   @default("pending") @db.VarChar(20)
  errorMessage   String?  @map("error_message")
  exportedAt     DateTime @default(now()) @map("exported_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], name: "idx_audience_exports_tenant")
  @@map("audience_exports")
}

// ─── FASE 6: DEALS / REVENUE ATTRIBUTION ─────────────────────────────────────

model Deal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id")     @db.Uuid
  leadId        String   @map("lead_id")       @db.Uuid

  // Revenue
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("CLP")       @db.VarChar(3)

  // Attribution
  funnelId      String?  @map("funnel_id")     @db.Uuid
  adsAccountId  String?  @map("ads_account_id") @db.Uuid
  campaignName  String?  @map("campaign_name") @db.VarChar(255)
  source        String   @default("manual")    @db.VarChar(100)

  // Stage
  stage         String   @default("won")       @db.VarChar(50)

  closedAt      DateTime @default(now()) @map("closed_at")  @db.Timestamptz()
  notes         String?

  createdBy     String?  @map("created_by")   @db.Uuid
  createdAt     DateTime @default(now())       @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt            @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  funnel     Funnel?     @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  adsAccount AdsAccount? @relation(fields: [adsAccountId], references: [id], onDelete: SetNull)
  createdByUser User?    @relation("DealCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId], name: "idx_deals_tenant")
  @@index([leadId],   name: "idx_deals_lead")
  @@index([tenantId, closedAt(sort: Desc)], name: "idx_deals_closed_at")
  @@map("deals")
}

// ─── FASE 7: BILLING (STRIPE) ─────────────────────────────────────────────────

model Subscription {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @unique @map("tenant_id") @db.Uuid

  stripeCustomerId    String?   @map("stripe_customer_id") @db.VarChar(255)
  paymentMethodMock   Json?     @map("payment_method_mock")
  stripeSubId         String?   @unique @map("stripe_sub_id") @db.VarChar(255)
  stripePriceId       String?   @map("stripe_price_id") @db.VarChar(255)

  plan                String    @default("starter") @db.VarChar(50)
  status              String    @default("trialing") @db.VarChar(50)
  currentPeriodStart  DateTime? @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd    DateTime? @map("current_period_end")   @db.Timestamptz()
  cancelAtPeriodEnd   Boolean   @default(false) @map("cancel_at_period_end")
  trialEnd            DateTime? @map("trial_end") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  subscriptionId    String?  @map("subscription_id") @db.Uuid

  stripeInvoiceId   String   @unique @map("stripe_invoice_id") @db.VarChar(255)
  stripeCustomerId  String   @map("stripe_customer_id") @db.VarChar(255)

  amountDue         Decimal  @default(0) @map("amount_due")  @db.Decimal(12, 2)
  amountPaid        Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  currency          String   @default("usd") @db.VarChar(3)
  status            String   @default("draft") @db.VarChar(50)
  hostedInvoiceUrl  String?  @map("hosted_invoice_url")
  invoicePdfUrl     String?  @map("invoice_pdf_url")
  periodStart       DateTime? @map("period_start") @db.Timestamptz()
  periodEnd         DateTime? @map("period_end")   @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)], name: "idx_invoices_tenant")
  @@map("invoices")
}

model AutomationFlow {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  trigger     String    @default("manual") @db.VarChar(50)
  status      String    @default("draft")  @db.VarChar(50)
  graph       Json      @default("{\"nodes\":[],\"edges\":[]}")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz()
  runCount    Int       @default(0)        @map("run_count")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now())    @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt         @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationFlowRun[]

  @@index([tenantId], name: "idx_automation_flows_tenant")
  @@map("automation_flows")
}

model AutomationFlowRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flowId     String    @map("flow_id")    @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  leadId     String?   @map("lead_id")   @db.Uuid
  status     String    @default("running") @db.VarChar(50)
  log        Json      @default("[]")
  startedAt  DateTime  @default(now()) @map("started_at")  @db.Timestamptz()
  finishedAt DateTime? @map("finished_at") @db.Timestamptz()

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId], name: "idx_flow_runs_flow")
  @@index([tenantId], name: "idx_flow_runs_tenant")
  @@map("automation_flow_runs")
}

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix") @db.VarChar(12)
  scopes      String[]
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz()
  expiresAt   DateTime? @map("expires_at")   @db.Timestamptz()
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], name: "idx_api_keys_tenant")
  @@map("api_keys")
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id")   @db.Uuid
  action     String   @db.VarChar(50)   // create|update|delete|read|login|export
  resource   String   @db.VarChar(100)  // lead|deal|user|funnel|api_key
  resourceId String?  @map("resource_id") @db.VarChar(255)
  changes    Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  status     String   @default("success") @db.VarChar(20)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)], name: "idx_audit_tenant_created")
  @@index([resource, resourceId],             name: "idx_audit_resource")
  @@index([userId, createdAt(sort: Desc)],    name: "idx_audit_user")
  @@map("audit_logs")
}

// ─── E-COMMERCE (Migration 017) ──────────────────────────────────────────────

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id")   @db.Uuid
  externalId String   @map("external_id") @db.VarChar(255)
  platform   String   @default("manual")  @db.VarChar(20) // shopify | woocommerce | manual
  name       String   @db.VarChar(500)
  sku        String?  @db.VarChar(100)
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("CLP") @db.VarChar(3)
  imageUrl   String?  @map("image_url")
  productUrl String?  @map("product_url")
  isActive   Boolean  @default(true)  @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([tenantId, platform, externalId], name: "uq_products_tenant_platform_external")
  @@index([tenantId], name: "idx_products_tenant")
  @@map("products")
}

model Cart {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  leadId               String?   @map("lead_id")   @db.Uuid
  externalId           String?   @map("external_id") @db.VarChar(255)
  platform             String    @default("manual") @db.VarChar(20)
  email                String?   @db.VarChar(255)
  phone                String?   @db.VarChar(20)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency             String    @default("CLP") @db.VarChar(3)
  status               String    @default("open") @db.VarChar(20) // open | recovered | ordered | expired
  checkoutUrl          String?   @map("checkout_url")
  recoveryAlertSentAt  DateTime? @map("recovery_alert_sent_at") @db.Timestamptz()
  orderedAt            DateTime? @map("ordered_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt      @map("updated_at") @db.Timestamptz()

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@unique([tenantId, platform, externalId], name: "uq_carts_tenant_platform_external")
  @@index([tenantId, status], name: "idx_carts_tenant_status")
  @@index([leadId], name: "idx_carts_lead")
  @@map("carts")
}

model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId     String   @map("cart_id")   @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  name       String   @db.VarChar(500)
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  imageUrl   String?  @map("image_url")
  productUrl String?  @map("product_url")

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([cartId], name: "idx_cart_items_cart")
  @@map("cart_items")
}
