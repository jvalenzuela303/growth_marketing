# ─── Aplicación ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Base de Datos (PostgreSQL) ───────────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_engine

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64_AT_LEAST_256_BITS

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── AI Engine (microservicio de scoring con LLM) ────────────────────────────
AI_ENGINE_URL=http://localhost:8000
# Secret compartido entre backend y AI Engine (header X-Internal-Secret)
INTERNAL_API_SECRET=CHANGE_ME_INTERNAL_SECRET

# ─── Workers BullMQ ──────────────────────────────────────────────────────────
SCORING_WORKER_CONCURRENCY=5
MESSAGING_WORKER_CONCURRENCY=3

# ─── Meta / Facebook ─────────────────────────────────────────────────────────
# Token de acceso de la App de Meta (System User con permisos de CAPI)
META_CAPI_TOKEN=
# Pixel ID por defecto (se sobreescribe por tenant en DB)
META_PIXEL_ID=
# WhatsApp Business Cloud API
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
# App Secret para validar firmas HMAC de webhooks
META_APP_SECRET=
# Token de verificación para el handshake de webhook
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RANDOM_STRING
# Solo para pruebas en Meta Event Test (dejar vacío en producción)
META_CAPI_TEST_CODE=

# ─── SendGrid ────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@thegrowthengine.com
SENDGRID_FROM_NAME=The Growth Engine

# ─── Gmail SMTP (notificaciones internas — dev/staging) ───────────────────────
# Usar en lugar de SendGrid para pruebas locales.
# Requisitos:
#   1. Activar verificación en 2 pasos en tu cuenta Google
#   2. Crear una App Password en: myaccount.google.com/apppasswords
#      (Seleccionar app: "Correo", dispositivo: "Otro" → copiar las 16 letras)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── GCP (solo en Cloud Run) ─────────────────────────────────────────────────
# En Cloud Run, DATABASE_URL se obtiene via Cloud SQL connector o Secret Manager
# GCP_PROJECT_ID=
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
