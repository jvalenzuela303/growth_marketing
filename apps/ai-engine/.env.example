# AI Engine — Variables de entorno
# Copia este archivo a .env y rellena los valores reales

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Redis (caché de sesiones y memoria contextual) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL (persistencia de scores y clasificaciones) ──────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/growth_engine

# ── Configuración del servicio ─────────────────────────────────────────────────
AI_ENGINE_PORT=8000
AI_ENGINE_ENV=development   # development | production
LOG_LEVEL=info

# ── Umbrales de scoring (sobreescribibles sin redeploy) ───────────────────────
HOT_LEAD_THRESHOLD=80
WARM_LEAD_THRESHOLD=60
COLD_LEAD_THRESHOLD=40

# ── Feature flags ──────────────────────────────────────────────────────────────
ENABLE_PROMPT_CACHING=true
FALLBACK_PROVIDER=openai    # Provider de fallback si el primario falla
